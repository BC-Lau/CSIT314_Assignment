@startuml
actor "Interior Designer" as Designer
boundary "IDPMediaPage" as Page
control "MediaUploadController" as Control
entity "IDP" as Project
entity "IDPMedia" as Media
Designer -> Page: uploadMedia()
activate Page
Page -> Control: uploadMedia(user, idpId, fileName, mimeType, bytes)
activate Control
Control -> Project: getIDPById(idpId)
activate Project
Project --> Control: project
 deactivate Project
alt [not owner]
  Control --> Page: error (not authorized)
  Page --> Designer: displayError(message)
else [owns IDP]
  Control -> Control: validate size, type and signature
  alt [invalid file]
    Control --> Page: error (invalid file)
    Page --> Designer: displayError(message)
  else [valid file]
    Control -> Media: createMedia(idpId, fileName, mimeType, bytes)
    activate Media
    Media --> Control: media metadata
    deactivate Media
    Control --> Page: success, media
    Page --> Designer: displaySuccess(message)
  end
end
deactivate Control
deactivate Page
@enduml
