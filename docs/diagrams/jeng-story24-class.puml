@startuml
skinparam classAttributeIconSize 0
class IDPMediaPage <<boundary>> {
  +uploadMedia()
  +loadMedia()
  +displayMedia(projectId, records)
  +removeMedia(projectId, mediaId)
  +displaySuccess(message)
  +displayError(message)
}
class MediaUploadController <<control>> {
  +uploadMedia(user, idpId, fileName, mimeType, bytes)
  +listMedia(user, idpId)
  +getMediaContent(user, mediaId)
  +deleteMedia(user, idpId, mediaId)
  +ownsIDP(user, idpId)
}
class IDP <<entity>> {
  +getIDPById(idpId)
  +getIDPsByDesigner(designerId)
}
class IDPMedia <<entity>> {
  +createMedia(idpId, fileName, mimeType, bytes)
  +getMediaForIDP(idpId)
  +getContent(mediaId)
  +deleteMedia(mediaId, idpId)
}
class InteriorDesigner <<entity>> {
  +id: Integer
  +canUploadIDPMedia(): Boolean
}
IDPMediaPage ..> MediaUploadController : requests
MediaUploadController ..> IDP : verifies owner
MediaUploadController ..> IDPMedia : reads/writes media
InteriorDesigner "1" -- "0..*" IDP : owns
IDP "1" *-- "0..*" IDPMedia : contains
@enduml
